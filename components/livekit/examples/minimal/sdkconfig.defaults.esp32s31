# Defaults for the ESP32-S31-Function-CoreBoard-1 (ESP32-S31-WROOM-3 module).
# Requires ESP-IDF v6.1 or later with the esp32s31 preview target enabled:
#   idf.py --preview set-target esp32s31
CONFIG_LK_EXAMPLE_CODEC_BOARD_TYPE="ESP32_S31_FUNCTION_COREBOARD_1"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_320=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_SPEED_200M=y
CONFIG_SPIRAM_FETCH_INSTRUCTIONS=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=256
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=8192
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

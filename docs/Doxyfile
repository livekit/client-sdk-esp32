PROJECT_NAME           = LiveKit ESP32 SDK
PROJECT_ICON           = customization/favicon.ico
OUTPUT_DIRECTORY       = ./output
OPTIMIZE_OUTPUT_FOR_C  = YES
WARN_IF_UNDOCUMENTED   = YES
INPUT                  = ../README.md \
                         ../docs \
                         ../components/livekit/include \
                         ../components/sandbox_token/include \
                         ../components/s31_board/include
INPUT                 += ../components/s31_board/README.md \
                         ../components/livekit/examples/minimal/README.md \
                         ../components/livekit/examples/minimal_video/README.md \
                         ../components/livekit/examples/voice_agent/README.md \
                         ../components/livekit/examples/custom_hardware/README.md \
                         ../components/livekit/examples/custom_hardware_s31/README.md \
                         ../tools/interop-test/README.md \
                         ../tools/s31-audio-test/README.md
# Keep linked README files as pages rather than implicit directory documentation.
IMPLICIT_DIR_DOCS      = NO
USE_MDFILE_AS_MAINPAGE = ./index.md
FILE_PATTERNS          = *.h *.md
EXTRACT_ALL            = YES
RECURSIVE              = YES
JAVADOC_AUTOBRIEF      = YES
GENERATE_LATEX         = NO
GENERATE_HTML          = YES
TIMESTAMP              = YES
INLINE_SIMPLE_STRUCTS  = YES
TYPEDEF_HIDES_STRUCT   = YES
SHOW_FILES             = NO
TOC_EXPAND             = YES
LAYOUT_FILE            = ./layout.xml
HTML_HEADER            = customization/header.html
PROJECT_NUMBER         = v0.3.11
FULL_SIDEBAR           = NO
HTML_EXTRA_STYLESHEET  = customization/doxygen-awesome.css \
						 customization/custom.css
HTML_COLORSTYLE        = LIGHT # required with Doxygen >= 1.9.5
